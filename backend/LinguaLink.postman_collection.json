            },
            "url": {
              "raw": "{{baseUrl}}/ai/flashcards",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "flashcards"]
            }
          }
        },
        {
          "name": "Get User Past Corrections",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ai/corrections",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "corrections"]
            }
          }
        }
      ]
    },
