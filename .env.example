# =====================================================================
# LinguaLink — Environment Configuration Template (Phase 17 Security)
# Copy this file to .env and supply your local or production values.
# NEVER commit your real .env file or API keys to GitHub!
# =====================================================================

# PostgreSQL Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lingualink
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password

# JWT Authentication
JWT_SECRET=lingualink-super-secret-key-change-this-in-production-must-be-256-bits
JWT_EXPIRATION_MS=86400000

# AI Provider Configuration (Phases 10-13)
# Options: 'gemini' (cloud free tier) or 'ollama' (local open-source)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama Configuration (Alternative to Gemini)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
